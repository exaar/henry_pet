{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "henry_pet",
  "version": "0.4.0",
  "identifier": "dev.exaar.henrypet",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../hermes-plugin/INSTALL.md": "hermes-plugin/INSTALL.md",
      "../hermes-plugin/henry_pet/plugin.yaml": "hermes-plugin/henry_pet/plugin.yaml",
      "../hermes-plugin/henry_pet/__init__.py": "hermes-plugin/henry_pet/__init__.py"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}